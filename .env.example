# ======================================================================
#  Fotograf — podešavanja. Kopirajte u .env i popunite.
#  NIKADA ne objavljujte .env fajl (već je u .gitignore).
# ======================================================================

# Domen na kom radi aplikacija (bez https://), npr. foto.mojstudio.rs
DOMAIN=foto.mojstudio.rs

# Javni URL — mora tačno da se poklapa sa domenom
PUBLIC_URL=https://foto.mojstudio.rs

# Jedini administrator (Google nalog)
ADMIN_EMAIL=minehost43@gmail.com

# Opciono: Google nalog čiji Drive čuva fotografije, ako NIJE isti kao gore
# (npr. studentski nalog sa 5 TB). Prazno = koristi se ADMIN_EMAIL.
DRIVE_EMAIL=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Tajni ključ za šifrovanje (32 bajta). Napravite ga komandom:
#   openssl rand -base64 32
# Ako ga izgubite, moraćete ponovo da povežete Google Drive i napravite nove linkove.
APP_SECRET=

# Maksimalna veličina jedne fotografije u MB
MAX_UPLOAD_MB=80

# --- Opciono: slanje mejla štampariji jednim dodirom (Gmail "App password") ---
# Google nalog → Bezbednost → Verifikacija u 2 koraka → Lozinke za aplikacije
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

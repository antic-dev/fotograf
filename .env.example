# ======================================================================
#  Fotograf — podešavanja. Kopirajte u .env i popunite.
#  NIKADA ne objavljujte .env fajl (već je u .gitignore).
# ======================================================================

# Domen na kom radi aplikacija (bez https://), npr. foto.mojstudio.rs
DOMAIN=foto.mojstudio.rs

# Javni URL — mora tačno da se poklapa sa domenom
PUBLIC_URL=https://foto.mojstudio.rs

# Prijava administratora (jedini nalog): mejl + lozinka (najmanje 8 znakova).
# Mejl se nigde ne prikazuje; lozinka se u bazi čuva samo kao jak heš. Kasnije je možete promeniti u
# aplikaciji (Podešavanja → Lozinka). Ako je zaboravite: upišite ovde novu
# i ponovo pokrenite server — ona tada zamenjuje staru.
# Lozinku stavite u jednostruke navodnike: ADMIN_PASSWORD='moja$Lozinka#1'
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opciono: jedini Google nalog čiji Drive sme da se poveže (npr. studentski
# nalog sa 5 TB). Prazno = nalog koji izaberete pri povezivanju.
DRIVE_EMAIL=

# Potrebno SAMO za povezivanje Google Drive-a (ne za prijavu).
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opciono: tajni ključ za šifrovanje (32 bajta, openssl rand -base64 32).
# Prazno = server ga sam napravi i čuva u folderu sa podacima.
APP_SECRET=

# Maksimalna veličina jedne fotografije u MB
MAX_UPLOAD_MB=80

# Najviše prostora na disku servera za sličice/preglede (GB). Originali su na Drive-u,
# pa se obrisano po potrebi ponovo napravi.
CACHE_MAX_GB=10

# --- Opciono: slanje mejla štampariji jednim dodirom (Gmail "App password") ---
# Google nalog → Bezbednost → Verifikacija u 2 koraka → Lozinke za aplikacije
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
